# ---- Auth ----
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- Database ----
# Local dev: a SQLite file (created automatically by `npm run db:push`)
DATABASE_URL="file:./data/golfday.db"
# Production free option: Turso (libSQL). Create a DB then use:
# DATABASE_URL="libsql://golfday-<org>.turso.io"
# DATABASE_AUTH_TOKEN="<turso-token>"

# ---- Golf course catalogue (optional) ----
# Free API key from https://golfcourseapi.com  (10 requests/min free tier)
GOLF_COURSE_API_KEY=""

# ---- Golf England / WHS CDH (optional, see docs/INTEGRATIONS.md) ----
# GOLF_ENGLAND_MODE=mock | cdh
GOLF_ENGLAND_MODE="mock"
# CDH_API_BASE="https://api.cdh.example.com/v1"
# CDH_API_KEY=""
