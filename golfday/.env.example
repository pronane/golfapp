# ---- Auth ----
# Session signing key. REQUIRED in production: generate one with
#   openssl rand -base64 48
# Placeholders from this file (and the built-in dev fallback) are rejected when
# NODE_ENV=production, because they are published in the repo and would let
# anybody mint a session cookie. Leave blank for local development only.
AUTH_SECRET=""

# ---- Database ----
# Make a fresh deployment set itself up (see docs/PUBLIC-DEMO.md):
#   AUTO_PUSH_SCHEMA=1  create the tables on boot if they are missing
#   DEMO_AUTOSEED=1     ...and load seed/demo.sql when the database has no accounts
# Both only ever create; neither deletes. Leave them off for real use.
# AUTO_PUSH_SCHEMA=""
# DEMO_AUTOSEED=""
# Local dev: a SQLite file (created automatically by `npm run db:push`)
DATABASE_URL="file:./data/golfday.db"
# Production free option: Turso (libSQL). Create a DB then use:
# DATABASE_URL="libsql://golfday-<org>.turso.io"
# DATABASE_AUTH_TOKEN="<turso-token>"

# ---- Golf course catalogue (optional) ----
# Free API key from https://golfcourseapi.com  (10 requests/min free tier)
GOLF_COURSE_API_KEY=""

# ---- Handicaps (optional, see docs/INTEGRATIONS.md) ----
# Default source for anybody who is not in a society:
#   mock | whs | cdh | ghin | golfcanada | golfaustralia
# A society can override this on its own page
# (manual / directory / WHS / GHIN / Golf Canada / Golf Australia / CDH).
GOLF_ENGLAND_MODE="mock"

# National WHS platform (DotGolf ISV API). eng | sco | wal | irl.
# WHS_COUNTRY="eng"
# WHS_API_USERNAME=""
# WHS_API_SECRET=""
# WHS_CLIENT_TOKEN=""          # paste it if the union issued a signed one
# WHS_API_BASE="https://isvapi.whsplatform.englandgolf.org"

# Overseas systems (GHIN, Golf Canada, Golf Australia) - see docs/INTEGRATIONS.md.
# OVERSEAS_GHIN_USERNAME=""
# OVERSEAS_GHIN_SECRET=""
# OVERSEAS_GHIN_CLIENT_TOKEN=""       # only if GHIN paired one with the login
# OVERSEAS_GOLF_CANADA_USERNAME=""
# OVERSEAS_GOLF_CANADA_SECRET=""
# OVERSEAS_GOLF_AUSTRALIA_SECRET=""   # the API key is all this one needs

# Or your own proxy that answers GET {base}/golfers/{id}
# CDH_API_BASE="https://api.cdh.example.com/v1"
# CDH_API_KEY=""

# ---- Social sign-in (optional, see docs/INTEGRATIONS.md) ----
# Each provider only appears on /login when both values are set.
# OAUTH_GOOGLE_ID=""
# OAUTH_GOOGLE_SECRET=""
# OAUTH_APPLE_ID=""            # the Apple Service ID
# OAUTH_APPLE_SECRET=""        # the client secret (Apple wants a signed JWT here)
# OAUTH_FACEBOOK_ID=""
# OAUTH_FACEBOOK_SECRET=""
# Public base URL used to build OAuth redirect URIs (needed behind a proxy)
# APP_URL="https://golfday.example.com"

# ---- Entry fees (optional) ----
# Stripe secret key turns on "Pay entry" (Stripe Checkout). Without it organisers
# mark cash/bank-transfer payments by hand in the Payments tab.
# STRIPE_SECRET_KEY="sk_test_..."
# Public URL of the site, used for Stripe's return links (defaults to the request origin)
# APP_URL="https://golfday.example.com"
